# Supabase project credentials — copy this file to .env and fill in real values.
# NEVER commit real values. The dashboard uses the anon key ONLY (never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The deployed worker's /mcp URL — the endpoint every runtime config snippet
# points at (backend.md §2/§9). Used by the onboarding config step; leave
# unset and onboarding shows a clean "not configured" state instead.
VITE_ANCHOR_ENDPOINT=
